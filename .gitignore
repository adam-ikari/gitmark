# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Signing keys, anywhere in the tree.
#
# Not paranoia. The release key for this project lives outside the repository
# (~/.config/mark-signing) precisely because a leaked signing key lets anyone sign
# an update Android accepts as this app — and this app holds the user's notes in
# local storage. Losing or replacing the key also means every install has to be
# removed before the next one can be installed, which destroys those notes.
#
# `*.jks` above already covered the usual extension inside android/, but a
# keystore dropped in the repository root is the more natural place to put one and
# was not ignored.
*.keystore
*.pass
signing/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
